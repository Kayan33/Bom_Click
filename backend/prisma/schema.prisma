generator client {
  provider = "prisma-client-js"
}
 
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
 
enum OpcaoPagamento {
  DEBITO
  CREDITO
  VALE_ALIMENTACAO
  VALE_REFEICAO
}
 
model Usuario {
  id   String @id @default(uuid())
  nome String
  email String @unique
  cpf String @unique @db.VarChar(14)
  senha String
  dataNascimento DateTime?
  cep String? @db.VarChar(8)
  logradouro String?
  bairro String?
  numero Int?
  // Relação entre Usuario e formasPagamento
  formasPagamento FormaPagamento[]
 
  // Relação entre Usuario e Compras
  compras Compras[]

  create_at DateTime? @default(now())
  update_at DateTime? @default(now())

  @@map("cadastro_usuario")
}
 
model FormaPagamento {
  id   String @id @default(uuid())
  meioPagamento OpcaoPagamento
  numeroCartao String @unique @db.VarChar(16)
  nome String
  cvv String? @db.VarChar(4)
  dataVencimento String @db.VarChar(7)
 
 
  // Relação entre FormaPagamento e Usuario
  usuarioId String
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
 
  // Relação entre FormaPagamento e pagamentos
  pagamentos PagamentoCompra[]

  create_at DateTime? @default(now())
  update_at DateTime? @default(now())

  @@map("cadastro_formaPagamento")
}
 
model Compras {
  id   String @id @default(uuid())
 
  // Relação entre Compras e Usuario
  usuarioId String
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
 
  // Relação Intermediária de muitos para muitos de Compras e Produtos
  itens ItensCompra[]
 
  // Relação entre Compras e PagamentosCompra
  pagamentos PagamentoCompra[]

  create_at DateTime? @default(now())
  update_at DateTime? @default(now())

  @@map("cadastro_compras")
}
 
model PagamentoCompra {
  iid   String @id @default(uuid())
 
  // Relação entre PagamentoCompra e Compra
  compraId        String
  compra         Compras        @relation(fields: [compraId], references: [id], onDelete: Cascade)
 
  // Relação entre PagamentoCompra e FormaPagamento  
  formaPagamentoId String
  formaPagamento FormaPagamento @relation(fields: [formaPagamentoId], references: [id], onDelete: Cascade)
 
  @@unique([compraId, formaPagamentoId])

  create_at DateTime? @default(now())
  update_at DateTime? @default(now())

  @@map("cadastro_pagamentoCompra")
}
 
model ItensCompra {
 id   String @id @default(uuid())
  quantidade Int
 
  // Relação entre ItensCompra e Compra
  compraId   String
  compra     Compras  @relation(fields: [compraId], references: [id], onDelete: Cascade)
 
  // Relação entre ItensCompra e Produto
  produtoId  String
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
 
  @@unique([compraId, produtoId])

  create_at DateTime? @default(now())
  update_at DateTime? @default(now())

  @@map("cadastro_itensCompra")
}
 
model Produto {
  id   String @id @default(uuid())
  imagem String
  valor Float
  quantidade Int
  valorEconomizado Float
 
  // Relação entre Produto e Mercado
  mercadoId String
  mercado Mercado @relation(fields: [mercadoId], references: [id])
 
  // Relação Intermediária de muitos para muitos de Produtos e Compras
  itens ItensCompra[]

  create_at DateTime? @default(now())
  update_at DateTime? @default(now())

  @@map("cadastro_produto")
}
 
 
model Mercado {
  id   String @id @default(uuid())
  nome String
  logo String
 
  // Relação entre Mercado e Produto
  produto Produto[]

  create_at DateTime? @default(now())
  update_at DateTime? @default(now())

  @@map("cadastro_mercado")
}
 
// tabela intermediária PagamentoCompra adicionada por causa da tabela compras e forma pagamento que no caso seria muitos pra muitos.
// tabela intermediária ItensCompra Adicionada por causa da tabela Compra e Produtos que no caso seria muitos pra muitos.
 
// enum limita as opções de pagamento, evitando erros de digitação ou dados inválidos.
 
 
//  cvv não pode ser armazenado, empresas de gateways ou outras que funcionam -
//  como intermediário de pagamento não permitem, ele deve ser coletado apenas
//  no momento da transação.
 
//  @@unique([tabela, tabela]) Pra evitar duplicações, o prisma gera erro devido a violação de unicidade.