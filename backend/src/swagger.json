{
  "openapi": "3.0.1",
  "info": {
    "title": "API Bom click",
    "description": "API de consulta de Preços.",
    "version": "1.0.0"
  },
  "paths": {
    "/CadastroUsuarios": {
      "post": {
        "summary": "Cadastra um novo usuário",
        "description": "Recebe os dados do usuário e os armazena no banco de dados.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string" },
                  "cpf": { "type": "string" },
                  "dataNascimento": { "type": "string", "format": "date-time" },
                  "senha": { "type": "string" },
                  "cep": { "type": "string" },
                  "logradouro": { "type": "string" },
                  "bairro": { "type": "string" },
                  "numero": { "type": "integer" },
                  "email": { "type": "string", "format": "email" }
                },
                "required": [
                  "nome",
                  "cpf",
                  "dataNascimento",
                  "senha",
                  "cep",
                  "logradouro",
                  "bairro",
                  "numero",
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário cadastrado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensagem": { "type": "string" }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno no servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/BuscaUsuarios": {
      "get": {
        "summary": "Busca todos os usuários",
        "description": "Retorna a lista de usuários cadastrados no sistema.",
        "operationId": "buscaUsuarios",
        "responses": {
          "200": {
            "description": "Lista de usuários retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer", "example": 1 },
                      "nome": { "type": "string", "example": "João Silva" },
                      "email": { "type": "string", "example": "joao@email.com" }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno ao buscar usuários",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Erro ao buscar usuário."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/BuscaUsuariosUnico/{id}": {
      "post": {
        "summary": "Busca um usuário pelo ID",
        "description": "Retorna os dados de um usuário específico com base no ID fornecido.",
        "operationId": "buscaUsuarioUnico",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do usuário a ser buscado"
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário encontrado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "example": "123" },
                    "nome": { "type": "string", "example": "Maria Oliveira" },
                    "email": { "type": "string", "example": "maria@email.com" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "example": "Usuário não encontrado." }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno ao buscar usuário",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "example": "Erro ao buscar usuário único." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/AlteraDadosUsuario/{id}": {
      "put": {
        "summary": "Altera os dados de um usuário pelo ID",
        "description": "Atualiza os dados de um usuário específico com base no ID fornecido.",
        "operationId": "alteraDadosUsuario",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do usuário a ser atualizado"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string", "example": "Carlos Souza" },
                  "cpf": { "type": "string", "example": "123.456.789-00" },
                  "dataNascimento": { "type": "string", "format": "date-time" },
                  "cep": { "type": "string", "example": "01010-010" },
                  "logradouro": { "type": "string", "example": "Rua das Flores" },
                  "bairro": { "type": "string", "example": "Centro" },
                  "numero": { "type": "integer", "example": 100 },
                  "email": { "type": "string", "example": "carlos@email.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensagem": { "type": "string", "example": "Alterado com Sucesso" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "example": "Usuário não encontrado." }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno ao alterar usuário",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "example": "Erro ao alterar usuário." }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
